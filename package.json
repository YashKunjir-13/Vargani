{
  "name": "pauti-pustak-monorepo",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@11.16.0",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "concurrently \"pnpm dev:api\" \"pnpm dev:worker\" \"pnpm dev:scheduler\"",
    "dev:api": "nx serve api",
    "dev:worker": "nx serve worker",
    "dev:scheduler": "nx serve scheduler",
    "build": "nx run-many -t build",
    "lint": "eslint \"{apps,packages}/**/*.ts\"",
    "lint:fix": "eslint \"{apps,packages}/**/*.ts\" --fix",
    "format": "prettier --write \"{apps,packages}/**/*.{ts,js,json,md,yml,yaml}\"",
    "format:check": "prettier --check \"{apps,packages}/**/*.{ts,js,json,md,yml,yaml}\"",
    "typecheck": "pnpm run build",
    "test": "jest --passWithNoTests",
    "test:unit": "jest --config jest.config.js",
    "test:integration": "jest --config jest.integration.config.js",
    "test:e2e": "playwright test",
    "test:coverage": "jest --coverage",
    "prisma:generate": "nx prisma:generate backend-database",
    "prisma:migrate:dev": "dotenv -e .env -- pnpm --filter @pauti-pustak/backend-database exec prisma migrate dev",
    "prisma:migrate:deploy": "dotenv -e .env -- pnpm --filter @pauti-pustak/backend-database exec prisma migrate deploy",
    "prisma:studio": "dotenv -e .env -- pnpm --filter @pauti-pustak/backend-database exec prisma studio",
    "docker:up": "docker compose --profile core up -d",
    "docker:down": "docker compose --profile core --profile messaging --profile observability down",
    "docker:logs": "docker compose logs -f",
    "docker:observability": "docker compose --profile core --profile messaging --profile observability up -d",
    "validate": "pnpm run format:check && pnpm run lint && pnpm run typecheck && pnpm run test && pnpm run build"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.7.1",
    "@commitlint/config-conventional": "^19.7.1",
    "@eslint/js": "^9.21.0",
    "@nx/js": "^20.4.6",
    "@nx/nest": "^20.4.6",
    "@nx/node": "^20.4.6",
    "@pact-foundation/pact": "^13.2.0",
    "@playwright/test": "^1.50.1",
    "@testcontainers/postgresql": "^10.18.0",
    "@testcontainers/redis": "^10.18.0",
    "@types/compression": "^1.7.5",
    "@types/cookie-parser": "^1.4.8",
    "@types/express": "^5.0.0",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.13.4",
    "@types/nodemailer": "^6.4.17",
    "@types/passport-jwt": "^4.0.1",
    "@types/supertest": "^6.0.2",
    "commitlint": "^19.7.1",
    "concurrently": "^9.1.2",
    "cross-env": "^7.0.3",
    "dotenv-cli": "^8.0.0",
    "eslint": "^9.21.0",
    "eslint-config-prettier": "^10.0.1",
    "husky": "^9.1.7",
    "jest": "^29.7.0",
    "lint-staged": "^15.4.3",
    "nx": "^20.4.6",
    "prettier": "^3.5.1",
    "prettier-plugin-organize-imports": "^4.1.0",
    "prisma": "^6.3.1",
    "rimraf": "^6.0.1",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "testcontainers": "^10.18.0",
    "ts-jest": "^29.2.5",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.24.0"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.744.0",
    "@aws-sdk/s3-request-presigner": "^3.744.0",
    "@nestjs/bullmq": "^11.0.2",
    "@nestjs/common": "^11.0.10",
    "@nestjs/config": "^4.0.0",
    "@nestjs/core": "^11.0.10",
    "@nestjs/jwt": "^11.0.0",
    "@nestjs/passport": "^11.0.5",
    "@nestjs/platform-express": "^11.0.10",
    "@nestjs/schedule": "^5.0.1",
    "@nestjs/swagger": "^11.0.4",
    "@nestjs/terminus": "^11.0.0",
    "@nestjs/throttler": "^6.4.0",
    "@opentelemetry/api": "^1.9.0",
    "@opentelemetry/auto-instrumentations-node": "^0.56.0",
    "@opentelemetry/exporter-metrics-otlp-http": "^0.57.2",
    "@opentelemetry/exporter-trace-otlp-http": "^0.57.2",
    "@opentelemetry/resources": "^1.30.1",
    "@opentelemetry/sdk-metrics": "^1.30.1",
    "@opentelemetry/sdk-node": "^0.57.2",
    "@opentelemetry/semantic-conventions": "^1.30.0",
    "@prisma/client": "^6.3.1",
    "argon2": "^0.41.1",
    "bullmq": "^5.41.4",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "compression": "^1.7.5",
    "cookie-parser": "^1.4.7",
    "date-fns": "^4.1.0",
    "decimal.js": "^10.5.0",
    "firebase-admin": "^13.1.0",
    "handlebars": "^4.7.8",
    "helmet": "^8.0.0",
    "ioredis": "^5.5.0",
    "nats": "^2.29.1",
    "nestjs-pino": "^4.3.0",
    "nodemailer": "^6.10.0",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "pg": "^8.13.3",
    "pino": "^9.6.0",
    "pino-http": "^10.4.0",
    "puppeteer": "^24.2.1",
    "razorpay": "^2.9.5",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "uuid": "^11.1.0",
    "zod": "^3.24.2"
  }
}
