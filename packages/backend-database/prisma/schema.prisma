// Service: shared infrastructure -- cross-module tenancy/RBAC/
// numbering/delivery building blocks (src/common/*)
// ------------------------------------------------------------

// Generic, race-condition-safe sequence counter shared by every module that
// needs org+festival-year-scoped numbering (receipts, bills, contribution
// receipts, ...). `sequenceName` disambiguates which numbering series this
// row tracks. Incremented exclusively via a single atomic
// `INSERT ... ON CONFLICT ... DO UPDATE ... RETURNING` statement (see
// SequenceCounterService) -- never via a separate read-then-write.
model SequenceCounter {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @db.Uuid
  festivalYear   Int
  sequenceName   String   @db.VarChar(60)
  lastSequence   BigInt   @default(0)
  updatedAt      DateTime @updatedAt

  @@unique([organizationId, festivalYear, sequenceName])
  @@map("sequence_counters")
}

enum WhatsAppDeliveryStatus {
  PENDING
  SENT
  FAILED
}

// Tracks best-effort WhatsApp delivery of a rendered document (receipt/bill
// PDF or image) to a recipient phone number. A delivery record's lifecycle
// is intentionally decoupled from the document it references -- a delivery
// failure here must never roll back or block retrieval of that document.
model WhatsAppDeliveryRecord {
  id                String                 @id @default(uuid()) @db.Uuid
  organizationId    String                 @db.Uuid
  recipientPhone    String                 @db.VarChar(20)
  mediaUrl          String                 @db.Text
  status            WhatsAppDeliveryStatus @default(PENDING)
  retryCount        Int                    @default(0)
  lastError         String?                @db.Text
  providerMessageId String?                @db.VarChar(200)
  relatedEntityType String?                @db.VarChar(50)
  relatedEntityId   String?                @db.Uuid
  createdAt         DateTime               @default(now())
  updatedAt         DateTime               @updatedAt

  @@index([organizationId, status])
  @@index([relatedEntityType, relatedEntityId])
  @@map("whatsapp_delivery_records")
}

