# Environment Configuration
NODE_ENV=development
PORT=3000
API_PREFIX=/api/v1

# Database (PostgreSQL)
DATABASE_URL=postgresql://pauti_user:pauti_password@localhost:5432/pauti_pustak_db?schema=public

# Redis & Caching
REDIS_URL=redis://localhost:6379

# Event Broker (NATS JetStream)
NATS_URL=nats://localhost:4222

# Security & Authentication (JWT RS256)
JWT_PRIVATE_KEY_PATH=./config/certs/jwt_private.key
JWT_PUBLIC_KEY_PATH=./config/certs/jwt_public.key
JWT_ACCESS_EXPIRATION=15m
JWT_REFRESH_EXPIRATION=7d

# Object Storage (MinIO / S3)
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=pauti-pustak-assets
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_FORCE_PATH_STYLE=true

# Payment Gateway (Razorpay)
RAZORPAY_KEY_ID=rzp_test_placeholder_key_id
RAZORPAY_KEY_SECRET=rzp_test_placeholder_key_secret

# Firebase Configuration
FIREBASE_PROJECT_ID=pauti-pustak-dev

# WhatsApp Delivery (shared, internal -- see apps/api/src/common/whatsapp)
WHATSAPP_API_URL=
WHATSAPP_API_TOKEN=
WHATSAPP_SENDER_NUMBER=

# Email Service (Mailpit)
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=no-reply@pautipustak.local

# Observability (OpenTelemetry / Prometheus)
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_SERVICE_NAME=pauti-pustak-backend

# PAN encryption (AES-256-GCM key material, any passphrase-shaped secret works)
PAN_ENCRYPTION_KEY=change-me-in-production
